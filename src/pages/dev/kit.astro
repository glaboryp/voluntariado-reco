---
import Base from '../../layouts/Base.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import ConfirmDialog from '../../components/ConfirmDialog.astro';
import Hero from '../../components/Hero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import type { Activity } from '../../lib/rules';

const base: Activity = {
  id: 1, title: 'Recogida en el Banco de Alimentos', description: 'Ayudamos a recoger y clasificar alimentos a la entrada del supermercado. Ven con ropa cómoda.',
  location: 'Mercadona, calle de Goya 54', startsAt: new Date('2026-12-13T09:00Z'), endsAt: new Date('2026-12-13T13:00Z'),
  signupClosesAt: new Date('2026-12-13T09:00Z'), capacity: 10, hidden: false, taken: 6,
};
const showDialog = Astro.url.searchParams.has('dialog');
---
<Base title="Kit · Voluntariados de Navidad">
  <Hero />
  <section id="voluntariados" class="wrap list">
    <h2>Voluntariados</h2>
    <ActivityCard activity={base} status="open" action="link" />
    <ActivityCard activity={{ ...base, id: 2, title: 'Merienda en la residencia San José', taken: 8, capacity: 8, startsAt: new Date('2026-12-20T16:00Z'), endsAt: null }} status="full" action="link" />
    <ActivityCard activity={{ ...base, id: 3, title: 'Turno de tarde: Banco de Alimentos', capacity: 60, taken: 21 }} status="open" action="post" joined />
    <ActivityCard activity={{ ...base, id: 4, title: 'Gran recogida de juguetes', taken: 3 }} status="closed" action="link" />
  </section>
  <section class="wrap list">
    <h2>Tus datos</h2>
    <form class="form">
      <div class="field"><label for="n">Nombre y apellidos</label><input id="n" aria-invalid="true" aria-describedby="n-e" /><p class="error" id="n-e">Escribe tu nombre y apellidos.</p></div>
      <div class="field"><label for="p">Teléfono</label><input id="p" inputmode="tel" value="612 345 678" /></div>
      <label class="choice"><input type="checkbox" /> <span>Acepto que Recoletos use mis datos para organizar el voluntariado.</span></label>
      <button type="button" class="btn" data-dialog="demo">Abrir diálogo</button>
    </form>
  </section>
  <ConfirmDialog id="demo" title="¿Avisamos a las 6 personas apuntadas?" open={showDialog}>
    <p>Has cambiado el lugar de este voluntariado. Podemos enviarles un email con el cambio.</p>
    <Fragment slot="actions">
      <button class="btn">Sí, enviar email</button>
      <button class="btn btn--quiet" data-close>No, les aviso yo</button>
    </Fragment>
  </ConfirmDialog>
  <SiteFooter slot="footer" />
</Base>
<style>
  .list { padding-top: clamp(1rem, 3vw, 3rem); }
  .list > h2 { font-size: var(--step-head); margin-bottom: 0.5rem; }
  .form { display: grid; gap: 1.25rem; max-width: 32rem; margin-top: 1.5rem; }
</style>
